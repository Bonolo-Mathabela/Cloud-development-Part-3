    "_exporter_id": "58160630"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-functions-key", "type": "string" },
      { "key": "value", "value": "{{functionKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:7071", "type": "string" },
    { "key": "functionKey", "value": "", "type": "string" },
    { "key": "orderId", "value": "ORD-2026-8801", "type": "string" }
  ],
