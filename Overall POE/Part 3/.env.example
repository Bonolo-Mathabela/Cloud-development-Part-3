# Copy this file to .env and change the values. Never commit the .env file.

# The tag of the Docker Hub images to run
IMAGE_TAG=v3.0

# Must be the same as the default function key in docker/keys/host.json
FUNCTION_KEY=CygywzCydtO1C0Y1SIK4Wf1aXAWErRJugFTYKhGC

# Signs the JWT tokens. Must be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_KEY=change-me

# The first Admin user, created when the gateway starts. Do not use $ # or quotes in the password
ADMIN_EMAIL=manager@coffeenchill.ac.za
ADMIN_PASSWORD=change-this-password
